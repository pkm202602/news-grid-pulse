<!-- JAVASCRIPT FOR MOIBILE MENU & SEARCH TOGGLE -->
<script>
// Search Panel Box Toggle
document.getElementById('searchBtn').addEventListener('click', function(e) {
  e.stopPropagation();
  var searchBox = document.getElementById('searchBox');
  searchBox.classList.toggle('active');
});

// Mobile Hamburger Button Action
document.getElementById('mobileMenuToggle').addEventListener('click', function(e) {
  e.stopPropagation();
  var menuMain = document.getElementById('menuMain');
  menuMain.classList.toggle('mobile-active');
});

// Mobile Accordion Click Logic for Sub-Menus
var dropTriggers = document.querySelectorAll('.drop-trigger');
dropTriggers.forEach(function(trigger) {
  trigger.addEventListener('click', function(e) {
    if (window.innerWidth <= 768) {
      e.preventDefault();
      e.stopPropagation();
      var nextEl = this.nextElementSibling;
      if (nextEl) {
        nextEl.classList.toggle('submenu-open');
      }
    }
  });
});

// Close open panels when clicking outside
document.addEventListener('click', function(e) {
  var searchBox = document.getElementById('searchBox');
  var searchBtn = document.getElementById('searchBtn');
  var menuMain = document.getElementById('menuMain');
  var toggleBtn = document.getElementById('mobileMenuToggle');
  
  if (searchBox && !searchBox.contains(e.target) && e.target !== searchBtn && !searchBtn.contains(e.target)) {
    searchBox.classList.remove('active');
  }
  if (menuMain && !menuMain.contains(e.target) && e.target !== toggleBtn && !toggleBtn.contains(e.target)) {
    menuMain.classList.remove('mobile-active');
  }
});
</script>

